# Local development (npm run dev).

# MSW mocks let the UI run without a backend.
VITE_API_MODE=mock
VITE_API_BASE_URL=/api

# When a new backend contract exists, proxy mode can target it through
# VITE_API_PROXY in .env.local. Vite currently strips the /api prefix;
# confirm that behavior against the new contract.
VITE_API_PROXY=
