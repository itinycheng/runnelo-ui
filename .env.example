# Copy to .env.local for machine-specific overrides (git-ignored).
# These are the VITE_-prefixed variables used by the app and mock preview.
# Application configuration lives in src/config/index.ts; the mock environment
# marker reads VITE_MOCK_ENV_* directly in src/mocks/handlers/environment.ts.

# Base URL prepended to every API request. Use /api with proxy/mock mode;
# use an empty value for a same-origin production deployment.
VITE_API_BASE_URL=/api

# HTTP request timeout in milliseconds.
VITE_API_TIMEOUT=30000

# How the app talks to its API: mock | proxy | direct (see .env for meaning).
VITE_API_MODE=mock

# Backend origin to proxy to when VITE_API_MODE=proxy (dev only), e.g. http://localhost:9104.
# The current Vite proxy strips VITE_API_BASE_URL before forwarding. Recheck
# that mapping when the new backend contract is available.
VITE_API_PROXY=

# Optional environment marker preview in mock mode only. These values do not
# define the future backend's environment metadata contract.
VITE_MOCK_ENV_LABEL=
VITE_MOCK_ENV_COLOR="#B42332"
VITE_MOCK_ENV_HEADER=false
VITE_MOCK_ENV_WATERMARK=false
