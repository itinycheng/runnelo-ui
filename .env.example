# Copy to .env.local for machine-specific overrides (git-ignored).
# These are all the VITE_-prefixed variables the app reads. See src/config/index.ts.

# Base URL prepended to every API request. Use /api with proxy/mock mode;
# use an empty value for a same-origin production deployment.
VITE_API_BASE_URL=/api

# HTTP request timeout in milliseconds.
VITE_API_TIMEOUT=30000

# How the app talks to its API: mock | proxy | direct (see .env for meaning).
VITE_API_MODE=mock

# Backend origin to proxy to when VITE_API_MODE=proxy (dev only), e.g. http://localhost:9104.
# Vite removes VITE_API_BASE_URL before forwarding because the current backend
# exposes controllers without an /api prefix.
VITE_API_PROXY=

# Optional local mock preview of the environment marker (VITE_API_MODE=mock only).
# Set a label and enable either or both display modes. These values do not
# configure deployed backends; use runnelo.ui.environment there.
VITE_MOCK_ENV_LABEL=
VITE_MOCK_ENV_COLOR="#B42332"
VITE_MOCK_ENV_HEADER=false
VITE_MOCK_ENV_WATERMARK=false
